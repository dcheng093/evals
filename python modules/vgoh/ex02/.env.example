# ORACLE CONFIGURATION TEMPLATE
# Instructions: Copy this file to .env and fill in the values below.

# The password required to bypass the security check
DB_PASS=your_password_here

# The operation mode (development/production)
MATRIX_MODE=development

# The connection string for the database
DATABASE_URL=local_instance

# The secret key for API access
API_KEY=Authenticated

# The verbosity of the logs (DEBUG/INFO/ERROR)
LOG_LEVEL=DEBUG

# The URL for the Zion network
ZION_ENDPOINT=Online